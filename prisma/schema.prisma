// ════════════════════════════════════════════════════════════════════
// Schema Prisma — Masa Madre SENA
// ════════════════════════════════════════════════════════════════════
// Modelos basados en los tipos del frontend (src/data/*.ts)
// Cuando llegue el momento, los helpers del frontend solo cambian la
// fuente de datos (de mock a fetch) sin modificar las firmas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
// AUTENTICACIÓN — Auth.js v5 (NextAuth)
// ════════════════════════════════════════════════════════════════════

/// Roles del sistema. Por ahora solo "ADMIN" activo.
/// Los demás están listos para activar después.
enum Rol {
  ADMIN
  PANADERIA
  CIUDADANO
}

/// Usuario del sistema (admin, panadería, ciudadano)
/// Compatible con Auth.js v5 (adapter de Prisma)
model Usuario {
  id            String    @id @default(cuid())
  nombre        String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // Para login con email/password
  imagen        String? // Avatar opcional
  rol           Rol       @default(ADMIN)

  cuentas  Cuenta[]
  sesiones Sesion[]

  // Relación opcional con Panaderia (cuando sea rol PANADERIA)
  panaderia Panaderia?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("usuarios")
}

/// Cuenta OAuth (Google, GitHub, etc.) — opcional
model Cuenta {
  id                String  @id @default(cuid())
  usuarioId         String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("cuentas")
}

/// Sesión activa del usuario
model Sesion {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  usuarioId    String
  expires      DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

/// Token de verificación (email, recuperación de contraseña)
model TokenVerificacion {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("tokens_verificacion")
}

// ════════════════════════════════════════════════════════════════════
// GEOGRAFÍA — Departamentos y Ciudades
// ════════════════════════════════════════════════════════════════════

/// Los 32 departamentos de Colombia
model Departamento {
  id            String  @id @default(cuid())
  slug          String  @unique
  nombre        String  @unique
  imagen        String
  coordsLng     Float // Longitud del centro
  coordsLat     Float // Latitud del centro
  zoomNivel     Float // Nivel de zoom recomendado para flyTo

  ciudades    Ciudad[]
  panaderias  Panaderia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("departamentos")
}

/// Ciudades principales de Colombia
model Ciudad {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String
  imagen String

  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  panaderias Panaderia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([slug, departamentoId])
  @@map("ciudades")
}

// ════════════════════════════════════════════════════════════════════
// PANADERÍAS Y PRODUCTOS
// ════════════════════════════════════════════════════════════════════

/// Panadería aliada del programa Masa Madre
model Panaderia {
  id                String   @id @default(cuid())
  nombre            String
  descripcionCorta  String   @db.Text
  telefono          String
  email             String?
  direccion         String
  urlGoogleMaps     String
  imagen            String
  horario           String
  imagenesCarrusel  String[] // Array de URLs (PostgreSQL nativo)
  coordsLng         Float    // Longitud
  coordsLat         Float    // Latitud

  // Relaciones
  ciudadId       String
  ciudad         Ciudad       @relation(fields: [ciudadId], references: [id])
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  // Productos asociados
  productos Producto[]

  // Usuario propietario (cuando llegue el rol PANADERIA)
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  // Estado de aprobación (para moderación admin)
  estado EstadoPanaderia @default(ACTIVA)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([departamentoId])
  @@index([ciudadId])
  @@index([estado])
  @@map("panaderias")
}

/// Estado de la panadería en el sistema
enum EstadoPanaderia {
  ACTIVA
  PENDIENTE // Esperando aprobación admin
  INACTIVA  // Desactivada temporalmente
  ARCHIVADA  // Archiva la panadería y la oculta
  RECHAZADA // Rechazada por admin
}

/// Productos destacados de cada panadería
model Producto {
  id     String @id @default(cuid())
  nombre String
  precio Int    // En pesos colombianos (sin decimales)
  imagen String

  panaderiaId String
  panaderia   Panaderia @relation(fields: [panaderiaId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([panaderiaId])
  @@map("productos")
}

// ════════════════════════════════════════════════════════════════════
// BLOG
// ════════════════════════════════════════════════════════════════════

/// Estado del post (borrador, publicado, archivado)
enum EstadoPost {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

/// Post del blog
model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  titulo      String
  descripcion String     @db.Text
  contenido   String     @db.Text // Markdown
  categoria   String
  keyword     String?
  imagen      String
  fechaIso    DateTime
  estado      EstadoPost @default(BORRADOR)

  tags       PostTag[]
  comentarios Comentario[]

  // Usuario que creó el post
  autorId String?
  // (sin @relation por simplicidad, se puede agregar después)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado])
  @@index([categoria])
  @@map("posts")
}

/// Tags asociados a un post (relación many-to-many simplificada)
model PostTag {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  label  String
  icon   String? // SVG path o nombre de ícono

  @@index([postId])
  @@map("post_tags")
}

/// Comentarios en posts (con moderación)
model Comentario {
  id     String          @id @default(cuid())
  texto  String          @db.Text
  autor  String
  avatar String?
  fecha  DateTime        @default(now())
  estado EstadoComentario @default(PENDIENTE)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([postId])
  @@index([estado])
  @@map("comentarios")
}

/// Estado de moderación del comentario
enum EstadoComentario {
  PENDIENTE
  APROBADO
  RECHAZADO
}